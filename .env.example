# MuleGuard environment template. Copy to .env (never commit .env).
# Database: sqlite file path or postgres URL
MULEGUARD_DB=artifacts/muleguard.db
# Ollama (optional; scoring works without it)
OLLAMA_BASE_URL=http://localhost:11434
# API
API_HOST=127.0.0.1
API_PORT=8000
# Upload size cap in MB for /v1/score/file and the Validation Lab. The default
# (512) admits a full-shape dataset export; lower it for a public deployment.
MAX_UPLOAD_MB=512

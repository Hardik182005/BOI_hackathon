!data/splits/

# --- Secrets ---
.env
*.pem
*.key

# --- Databases / studies ---
*.db
*.sqlite3
# Demo case database ships with the repo so a fresh clone has a populated
# review queue. Synthetic DEMO-*/qa-harness records only, no customer data.
!artifacts/muleguard.db
artifacts/optuna/*

# --- Node ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Large model binaries kept out of git; manifests + hashes are committed ---
artifacts/models/*.bin
artifacts/models/*.cbm
artifacts/models/*.joblib
# The two serving models ship with the repo so a fresh clone can score
# without a multi-hour retrain. Both are covered by the release manifest
# and verified against their registry SHA-256 at gate time.
!artifacts/models/final_bundle.joblib
!artifacts/models/merchant_verifier.joblib
artifacts/tabpfn_cache/
artifacts/predictions/

# --- TypeScript ---
*.tsbuildinfo

# --- Git folders ---
.git_new/
.git_old/
.git_to_delete/



# --- Dry-run + sealed payloads: derived from the raw workbook, large, regenerable ---
artifacts/dry_run/
artifacts/sealed_validation/

# --- Local run logs ---
logs/


FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MULEGUARD_DB=/app/artifacts/muleguard.db

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e .

COPY configs ./configs
# model bundle + metrics are mounted or baked at deploy time:
#   docker run -v ./artifacts:/app/artifacts ...
COPY data/splits ./data/splits

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c \
    "import httpx;httpx.get('http://localhost:8000/health/live').raise_for_status()"
CMD ["uvicorn", "muleguard.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
